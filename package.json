{
  "name": "dsh-context",
  "version": "0.12.2",
  "description": "A DeepSeek Harness plugin for context insight and management, with context dashboard and context command, for understanding how the context is made of, and how it evolves.",
  "author": "bowenliang123",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bowenliang123/dsh-context.git"
  },
  "homepage": "https://github.com/bowenliang123/dsh-context#readme",
  "bugs": {
    "url": "https://github.com/bowenliang123/dsh-context/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "register": "bash scripts/register.sh",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node tests/host.test.mjs && node tests/client.test.mjs",
    "release": "bash scripts/publish.sh",
    "hooks": "bash scripts/install-hooks.sh",
    "repro": "node tests/repro-real-react.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "context",
    "token",
    "ui"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "playwright-core": "^1.62.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-projection": "0.1.0-rc.7",
    "@deepseek-ai/dsh-token-meter": "0.1.0-rc.7",
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.9.0"
}
